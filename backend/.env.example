# Required
MONGODB_URI=mongodb://localhost:27017/lyceum
JWT_SECRET=replace-with-at-least-32-random-characters
# Browser origin allowed by CORS (frontend project "lyceum", not lyceum-server)
FRONTEND_URL=http://localhost:3000

# Optional, required for Google Sign-In
GOOGLE_CLIENT_ID=

# Optional, required for profile images and blob administration
BLOB_READ_WRITE_TOKEN=

# Runtime
NODE_ENV=development
PORT=5000
